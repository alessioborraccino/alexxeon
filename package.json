{
  "name": "alexxeon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next dev",
    "prebuild": "node --import tsx scripts/prepare-content.ts && node --import tsx scripts/optimize-images.ts",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:export": "node --import tsx scripts/check-export.ts",
    "predev": "npm run prebuild",
    "prestart": "npm run prebuild"
  },
  "dependencies": {
    "@portabletext/react": "8.0.1",
    "@sanity/client": "8.11.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
